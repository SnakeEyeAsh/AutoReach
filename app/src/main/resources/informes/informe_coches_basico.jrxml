<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" 
              name="informe_coches_basico" 
              pageWidth="595" 
              pageHeight="842" 
              columnWidth="535" 
              leftMargin="30" 
              rightMargin="30" 
              topMargin="20" 
              bottomMargin="20">
    
    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>
    
    <!-- Estilos -->
    <style name="Header_Title" forecolor="#1E3A8A" fontSize="22" isBold="true"/>
    <style name="Header_Subtitle" forecolor="#F97316" fontSize="12" isBold="false"/>
    <style name="Table_Header" mode="Opaque" backcolor="#1E3A8A" forecolor="#FFFFFF" fontSize="11" isBold="true"/>
    <style name="Table_Cell" fontSize="10" forecolor="#374151"/>
    
    <!-- Parámetros -->
    <parameter name="REPORT_TITLE" class="java.lang.String">
        <defaultValueExpression><![CDATA["INVENTARIO DE VEHÍCULOS"]]></defaultValueExpression>
    </parameter>
    
    <!-- Campos -->
    <field name="marca" class="java.lang.String"/>
    <field name="modelo" class="java.lang.String"/>
    <field name="año" class="java.lang.Integer"/>
    <field name="matricula" class="java.lang.String"/>
    
    <!-- Variables -->
    <variable name="RowNumber" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[1]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    
    <variable name="TotalVehiculos" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[1]]></variableExpression>
    </variable>
    
    <!-- TÍTULO -->
    <title>
        <band height="100">
            <!-- Barra superior -->
            <rectangle>
                <reportElement mode="Opaque" x="0" y="0" width="535" height="5" backcolor="#1E3A8A"/>
            </rectangle>
            
            <!-- Logo/Nombre empresa -->
            <staticText>
                <reportElement x="0" y="15" width="180" height="25" forecolor="#F97316"/>
                <textElement verticalAlignment="Middle">
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[AutoReach]]></text>
            </staticText>
            
            <!-- Título del reporte -->
            <textField>
                <reportElement style="Header_Title" x="0" y="45" width="400" height="25"/>
                <textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression>
            </textField>
            
            <!-- Fecha de generación -->
            <staticText>
                <reportElement x="400" y="15" width="135" height="15" forecolor="#6B7280"/>
                <textElement textAlignment="Right">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Fecha de emisión:]]></text>
            </staticText>
            
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="400" y="30" width="135" height="15" forecolor="#374151"/>
                <textElement textAlignment="Right">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
            
            <!-- Línea separadora -->
            <line>
                <reportElement x="0" y="78" width="535" height="1" forecolor="#DBEAFE"/>
                <graphicElement>
                    <pen lineWidth="1.5"/>
                </graphicElement>
            </line>
            
            <line>
                <reportElement x="0" y="82" width="100" height="1" forecolor="#F97316"/>
                <graphicElement>
                    <pen lineWidth="2.5"/>
                </graphicElement>
            </line>
        </band>
    </title>
    
    <!-- ENCABEZADO DE COLUMNAS -->
    <columnHeader>
        <band height="30">
            <!-- Fondo del encabezado -->
            <rectangle>
                <reportElement mode="Opaque" x="0" y="5" width="535" height="25" backcolor="#1E3A8A"/>
            </rectangle>
            
            <!-- N° -->
            <staticText>
                <reportElement mode="Opaque" x="0" y="5" width="40" height="25" backcolor="#1E3A8A" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[N°]]></text>
            </staticText>
            
            <!-- MARCA -->
            <staticText>
                <reportElement mode="Opaque" x="40" y="5" width="130" height="25" backcolor="#1E3A8A" forecolor="#FFFFFF"/>
                <box leftPadding="8"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[MARCA]]></text>
            </staticText>
            
            <!-- MODELO -->
            <staticText>
                <reportElement mode="Opaque" x="170" y="5" width="180" height="25" backcolor="#1E3A8A" forecolor="#FFFFFF"/>
                <box leftPadding="8"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[MODELO]]></text>
            </staticText>
            
            <!-- MATRÍCULA -->
            <staticText>
                <reportElement mode="Opaque" x="350" y="5" width="100" height="25" backcolor="#1E3A8A" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[MATRÍCULA]]></text>
            </staticText>
            
            <!-- AÑO -->
            <staticText>
                <reportElement mode="Opaque" x="450" y="5" width="85" height="25" backcolor="#1E3A8A" forecolor="#FFFFFF"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[AÑO]]></text>
            </staticText>
        </band>
    </columnHeader>
    
    <!-- DETALLE / FILAS -->
    <detail>
        <band height="25">
            <!-- Fondo alternado -->
            <rectangle>
                <reportElement mode="Opaque" x="0" y="0" width="535" height="25" backcolor="#F9FAFB">
                    <printWhenExpression><![CDATA[$V{RowNumber} % 2 == 0]]></printWhenExpression>
                </reportElement>
            </rectangle>
            
            <!-- Número de fila -->
            <textField>
                <reportElement x="0" y="0" width="40" height="25" forecolor="#6B7280"/>
                <box topPadding="4" bottomPadding="4"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{RowNumber}]]></textFieldExpression>
            </textField>
            
            <!-- Marca -->
            <textField>
                <reportElement style="Table_Cell" x="40" y="0" width="130" height="25"/>
                <box leftPadding="8" topPadding="4" bottomPadding="4"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{marca}]]></textFieldExpression>
            </textField>
            
            <!-- Modelo -->
            <textField>
                <reportElement style="Table_Cell" x="170" y="0" width="180" height="25"/>
                <box leftPadding="8" topPadding="4" bottomPadding="4"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{modelo}]]></textFieldExpression>
            </textField>
            
            <!-- Matrícula -->
            <textField>
                <reportElement style="Table_Cell" x="350" y="0" width="100" height="25" forecolor="#F97316"/>
                <box topPadding="4" bottomPadding="4"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{matricula}]]></textFieldExpression>
            </textField>
            
            <!-- Año -->
            <textField>
                <reportElement style="Table_Cell" x="450" y="0" width="85" height="25"/>
                <box topPadding="4" bottomPadding="4"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{año}]]></textFieldExpression>
            </textField>
            
            <!-- Línea separadora sutil -->
            <line>
                <reportElement x="0" y="24" width="535" height="1" forecolor="#E5E7EB"/>
            </line>
        </band>
    </detail>
    
    <!-- PIE DE PÁGINA -->
    <pageFooter>
        <band height="60">
            <!-- Línea superior -->
            <line>
                <reportElement x="0" y="10" width="535" height="1" forecolor="#DBEAFE"/>
                <graphicElement>
                    <pen lineWidth="1.0"/>
                </graphicElement>
            </line>
            
            <!-- Información de la empresa -->
            <staticText>
                <reportElement x="0" y="20" width="350" height="15" forecolor="#374151"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[AutoReach - Soluciones Técnicas Automotrices]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="0" y="35" width="350" height="12" forecolor="#6B7280"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <text><![CDATA[www.autoreach.com | contacto@autoreach.com]]></text>
            </staticText>
            
            <!-- Número de página -->
            <textField>
                <reportElement x="400" y="20" width="135" height="20" forecolor="#374151"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            
            <!-- Barra inferior -->
            <rectangle>
                <reportElement mode="Opaque" x="0" y="56" width="535" height="3" backcolor="#1E3A8A"/>
            </rectangle>
        </band>
    </pageFooter>
    
    <!-- RESUMEN FINAL -->
    <summary>
        <band height="80">
            <!-- Línea separadora -->
            <line>
                <reportElement x="0" y="15" width="535" height="1" forecolor="#DBEAFE"/>
                <graphicElement>
                    <pen lineWidth="1.5"/>
                </graphicElement>
            </line>
            
            <!-- Panel de resumen -->
            <rectangle radius="8">
                <reportElement mode="Opaque" x="200" y="35" width="335" height="40" backcolor="#1E3A8A"/>
            </rectangle>
            
            <staticText>
                <reportElement x="210" y="42" width="180" height="25" forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font size="13" isBold="true"/>
                </textElement>
                <text><![CDATA[TOTAL DE VEHÍCULOS:]]></text>
            </staticText>
            
            <textField>
                <reportElement x="395" y="42" width="130" height="25" forecolor="#F97316"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{TotalVehiculos} + " unidades"]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
