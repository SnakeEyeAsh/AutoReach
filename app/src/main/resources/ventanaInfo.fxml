<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefWidth="460.0" spacing="0"
      style="-fx-background-color: white; -fx-font-family: 'Segoe UI';"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javafx.App.controladorEmergente">

   <children>

      <!-- ── Cabecera ─────────────────────────────────────────── -->
      <Label text="Confirmar Compra" prefWidth="460.0" prefHeight="48.0"
             style="-fx-background-color: #1E3A8A; -fx-text-fill: white;
                    -fx-font-size: 16; -fx-font-weight: bold; -fx-padding: 0 0 0 20;" />

      <!-- ── Cuerpo ─────────────────────────────────────────────── -->
      <VBox spacing="12.0" style="-fx-padding: 20 24 10 24;">

         <!-- Sección: Vehículo -->
         <Label text="DATOS DEL VEHÍCULO"
                style="-fx-font-size: 10; -fx-text-fill: #6B7280; -fx-font-weight: bold;" />

         <!-- vin_coche / matrícula -->
         <HBox spacing="0" alignment="CENTER_LEFT">
            <Label text="Vehículo:" prefWidth="150.0">
               <font><Font name="System Bold Italic" size="13.0" /></font>
            </Label>
            <Label fx:id="lblVehiculo" text="—"
                   style="-fx-font-size: 13; -fx-text-fill: #1F2937; -fx-font-weight: bold;" />
         </HBox>

         <HBox spacing="0" alignment="CENTER_LEFT">
            <Label text="Matrícula (VIN):" prefWidth="150.0">
               <font><Font name="System Bold Italic" size="13.0" /></font>
            </Label>
            <Label fx:id="lblMatricula" text="—"
                   style="-fx-font-size: 13; -fx-text-fill: #374151;" />
         </HBox>

         <!-- monto_total -->
         <HBox spacing="0" alignment="CENTER_LEFT">
            <Label text="Monto Total:" prefWidth="150.0">
               <font><Font name="System Bold Italic" size="13.0" /></font>
            </Label>
            <Label fx:id="lblMonto" text="—"
                   style="-fx-font-size: 15; -fx-text-fill: #059669; -fx-font-weight: bold;" />
         </HBox>

         <Separator>
            <VBox.margin><Insets top="4.0" bottom="4.0" /></VBox.margin>
         </Separator>

         <!-- Sección: Transacción -->
         <Label text="DATOS DE LA TRANSACCIÓN"
                style="-fx-font-size: 10; -fx-text-fill: #6B7280; -fx-font-weight: bold;" />

         <!-- tipo_transaccion (fijo VENTA) -->
         <HBox spacing="0" alignment="CENTER_LEFT">
            <Label text="Tipo:" prefWidth="150.0">
               <font><Font name="System Bold Italic" size="13.0" /></font>
            </Label>
            <Label text="VENTA"
                   style="-fx-font-size: 13; -fx-text-fill: #1E3A8A; -fx-font-weight: bold;" />
         </HBox>

         <!-- cliente_id / nombre -->
         <HBox spacing="0" alignment="CENTER_LEFT">
            <Label text="Cliente:" prefWidth="150.0">
               <font><Font name="System Bold Italic" size="13.0" /></font>
            </Label>
            <Label fx:id="lblCliente" text="—"
                   style="-fx-font-size: 13; -fx-text-fill: #374151;" />
         </HBox>

         <!-- fecha_transaccion (auto, solo informativa) -->
         <HBox spacing="0" alignment="CENTER_LEFT">
            <Label text="Fecha:" prefWidth="150.0">
               <font><Font name="System Bold Italic" size="13.0" /></font>
            </Label>
            <Label fx:id="lblFecha" text="—"
                   style="-fx-font-size: 13; -fx-text-fill: #374151;" />
         </HBox>

         <!-- estado_pago (editable) -->
         <HBox spacing="0" alignment="CENTER_LEFT">
            <Label text="Estado de Pago:" prefWidth="150.0">
               <font><Font name="System Bold Italic" size="13.0" /></font>
            </Label>
            <ComboBox fx:id="cmbEstadoPago" prefWidth="200.0" />
         </HBox>

      </VBox>

      <!-- ── Spacer ──────────────────────────────────────────── -->
      <Region VBox.vgrow="ALWAYS" />

      <!-- ── Botones ─────────────────────────────────────────── -->
      <HBox alignment="CENTER_RIGHT" spacing="12.0"
            style="-fx-padding: 12 24; -fx-border-color: #E5E7EB; -fx-border-width: 1 0 0 0;">
         <Button fx:id="btnAceptarCompra" mnemonicParsing="false" onAction="#RealizarCompra"
                 text="Confirmar Compra" prefWidth="150.0" prefHeight="34.0"
                 style="-fx-background-color: #1E3A8A; -fx-text-fill: white;
                        -fx-font-weight: bold; -fx-cursor: hand;" />
         <Button fx:id="brnCancelarCompra" mnemonicParsing="false" onAction="#btnCancelarCompra"
                 text="Cancelar" prefWidth="90.0" prefHeight="34.0"
                 style="-fx-background-color: #E5E7EB; -fx-cursor: hand;" />
      </HBox>

   </children>
</VBox>
